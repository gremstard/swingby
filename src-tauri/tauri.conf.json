{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Swingby",
  "version": "0.6.0",
  "identifier": "com.swingby.game",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5188",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Swingby",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 480,
        "minHeight": 600,
        "backgroundColor": "#05060c",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "Game",
    "shortDescription": "One-button gravity slingshot game",
    "longDescription": "Hold to orbit, release to fly. A one-button arcade game about gravity.",
    "copyright": "\u00a9 2026",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}